# Copy to .env.local (local development) or set in the Render dashboard (production).
# Never commit real values.

# --- Database (Supabase Postgres) ---
# Connection string of the EduLevel Supabase project (pooler, port 6543 or session port 5432).
DATABASE_URL=
# Optional: PEM certificate of the database server, to verify TLS strictly.
DATABASE_SSL_CA=

# --- Owner (teacher) login ---
OWNER_USERNAME=jasurbek
# Required to log in as owner. Used once to create the owner row; change the password in the admin panel afterwards.
OWNER_PASSWORD=
# Set once to force a new owner password on the next start, then remove it.
OWNER_RESET_PASSWORD=

# --- AI (server-side only) ---
GEMINI_API_KEY=
# Free-tier fallback providers (each is used only when its key is set; Free Only mode is always on).
GROQ_API_KEY=
OPENROUTER_API_KEY=
# DeepSeek and Mistral answer HTTP 402 without a funded account; they are switched off automatically then.
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
# Cloudflare Workers AI needs BOTH values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SAMBANOVA_API_KEY=
SILICONFLOW_API_KEY=
# --- Zero-cost confirmations (owner, after checking billing / free-tier pages; never set these from code) ---
# Gemini may be called only when its free tier is confirmed for this account. Without this, no Gemini request is sent.
GEMINI_FREE_TIER_CONFIRMED=
# Comma list of provider:model that the owner confirmed as free, e.g. groq:llama-3.1-8b-instant,cloudflare:@cf/meta/llama-3.1-8b-instruct
# Nothing else is ever called. OpenRouter needs no entry: its ':free' models with price 0 are read from its catalogue.
AI_CONFIRMED_FREE=
# Optional per-provider model override (must be a free model).
# GROQ_MODEL= OPENROUTER_MODEL= CLOUDFLARE_MODEL= SAMBANOVA_MODEL= SILICONFLOW_MODEL=
# Server voice (Gemini TTS) is off unless set to 1; the device voice is free and used by default.
# ALLOW_GEMINI_TTS=1

# --- Image storage (Supabase Storage, server-side only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: bucket name (created as a public bucket on first upload).
SUPABASE_STORAGE_BUCKET=edulevel-media

# --- Public URL of the deployed app ---
APP_URL=

# --- Firebase web config (Google sign-in) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Telegram deposit bot (from @BotFather). Leave empty until the bot is created; then redeploy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Secret for the scheduler that sends the daily reminders and the weekly digest (POST /api/telegram/cron?job=reminders|digest, header x-cron-secret).
TELEGRAM_CRON_SECRET=
